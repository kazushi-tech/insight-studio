# =============================================================================
# Insight Studio — ローカル開発用 環境変数テンプレート（実値はコミットしない）
# =============================================================================
# 使い方:  cp .env.example .env  してから実値を埋める。`.env` は .gitignore 済み。
#
# このリポジトリ root の .env を読み込むのは次の3者:
#   1. ads-insights backend … backends/ads-insights/web/app/backend_api.py が
#      リポジトリ root の .env を読む（APP_PASSWORD / JWT_SECRET / GEMINI_API_KEY 等）
#   2. Vite (frontend)       … VITE_* で始まる変数のみブラウザバンドルへ露出する。
#      → 秘密値（APP_PASSWORD / JWT_SECRET / *_API_KEY 等）には VITE_ を付けないこと
#   3. vite.config.js proxy  … ADS_PROXY_TARGET / ML_PROXY_TARGET（任意・サーバー専用）
#
# market-lens-ai backend は自分の backends/market-lens-ai/.env を読む（CWD基準）。
# ANTHROPIC_API_KEY 等は本来そちらに置く。手順は docs/local-verification.md を参照。
#
# 本番 (Vercel / Render) の環境変数は、このファイルではなく各ダッシュボードで設定する。
# =============================================================================

# ----- 認証 (ads-insights backend / 必須) -----------------------------------
# 管理者ログインのパスワード。未設定だと backend 起動時にエラーになる。
# 正準名は APP_PASSWORD。旧名 `管理者パスワード`(日本語キー) も fallback で読まれる。
APP_PASSWORD=change-me-admin-password

# JWT 署名鍵（十分ランダムに。例: openssl rand -hex 32）。未設定だとエラーになる。
JWT_SECRET=change-me-random-hex-secret

# RBAC のメールログイン用ユーザー定義（任意）。password_hash は sha256。
# AUTH_USERS=[{"user_id":"admin1","email":"you@example.com","password_hash":"<sha256>","role":"admin","display_name":"You"}]

# ----- AI キー（キー名の正準化）---------------------------------------------
# ★ Gemini は GEMINI_API_KEY（全部大文字）が正準名。
#   コードの参照順: GEMINI_API_KEY → GOOGLE_API_KEY → GOOGLE_GENERATIVE_AI_API_KEY。
#   旧 `Gemini_API_KEY`（混在ケース）はどのコードからも読まれないので使わない。
GEMINI_API_KEY=your-gemini-api-key

# サーバー側 Gemini キーを使うか（= ブラウザにAPIキーを渡さない運用にするか）:
#   false … サーバーの GEMINI_API_KEY を全リクエストで使用（.env 駆動のローカル確認はこちら）
#   true  … 各ユーザーが UI で自分のキーを入力（サーバーキー不要・アプリ既定）
GEMINI_REQUIRE_CLIENT_KEY=false

# ★ Claude は ANTHROPIC_API_KEY が正準名（旧 `Claude_API_KEY` は読まれない）。
#   ads-insights は使わない。market-lens-ai backend が参照する変数なので、
#   本来は backends/market-lens-ai/.env に置く（ここに置いても害はない）。
ANTHROPIC_API_KEY=your-anthropic-api-key

# ----- BigQuery / GCP（広告グラフ・AI考察に必要 / ads-insights）--------------
# 広告グラフと AI考察 は BigQuery を使う。次のどちらかで認証する:
#   方法A(本番想定): サービスアカウント鍵JSON を Base64 化して設定。
#     PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content key.json -Raw)))
#   GOOGLE_CREDENTIALS_JSON=base64-encoded-service-account-json
#
#   方法B(ローカル推奨): ADC を使う。GOOGLE_CREDENTIALS_JSON は未設定のまま、事前に
#     `gcloud auth application-default login` を実行しておく。
#
# BigQuery プロジェクトID（既定: analyzedataplatform）。
# GCP_PROJECT_ID=analyzedataplatform

# ----- データソース (ads-insights) ------------------------------------------
# excel(既定) / mock / ga4。広告グラフは BigQuery 経由なので通常は excel のままでよい。
DATA_PROVIDER=excel

# ----- CORS（任意）----------------------------------------------------------
# 追加で許可するオリジン（カンマ区切り）。ローカル開発では通常不要。
# CORS_ALLOWED_ORIGINS=

# ----- frontend / Vite（任意・サーバー専用 / 秘密値は置かない）---------------
# vite proxy の転送先を上書き（既定はローカル backend）。
# ADS_PROXY_TARGET=http://127.0.0.1:8001
# ML_PROXY_TARGET=http://127.0.0.1:8002
#
# 非プロキシ(本番)オリジンで直叩きする backend の公開URL（任意）。
# ローカルでは未設定にして same-origin プロキシ(/api/ads, /api/ml)を使うこと。
# VITE_ADS_INSIGHTS_API_ORIGIN=
# VITE_MARKET_LENS_API_ORIGIN=
