# Insight Studio local template. Never commit real values.
# Canonical contract: docs/operations/environment-contract.md

# --- Frontend public values -------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
VITE_ENABLE_PROJECT_MANAGEMENT=true
VITE_BQ_SERVICE_ACCOUNT_EMAIL=
VITE_BILLING_PLAN_KEY=starter
VITE_SENTRY_DSN=
VITE_ENABLE_SPEED_INSIGHTS=false
VITE_GIT_COMMIT_SHA=local
VITE_SALES_CONTACT_URL=

# --- Local proxy ------------------------------------------------------------
ADS_PROXY_TARGET=http://127.0.0.1:8001
ML_PROXY_TARGET=http://127.0.0.1:8002

# --- Managed platform database ---------------------------------------------
# Production must be PostgreSQL with TLS and backup/PITR. SQLite is test-only.
DATABASE_URL=
DATABASE_SSLMODE=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --- Clerk server verification / invitation --------------------------------
# CLERK_JWT_PUBLIC_KEY accepts a PEM public key with literal \n when needed.
CLERK_JWT_PUBLIC_KEY=
CLERK_ISSUER=
CLERK_ALLOWED_AZP=http://127.0.0.1:3002
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
PROJECT_INVITE_HASH_SECRET=
PLATFORM_ADMIN_CLERK_USER_IDS=

# --- Privacy / observability ------------------------------------------------
OBSERVABILITY_HASH_SALT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
RATE_LIMIT_HASH_SECRET=
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
LEGAL_AUDIT_HASH_SECRET=
LEGAL_REQUIRED_DOCUMENT_KEYS=terms,privacy

# --- Billing (server only) --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PLAN_PRICES_JSON={}
BILLING_CHECKOUT_SUCCESS_URL=http://127.0.0.1:3002/settings?checkout=success
BILLING_CHECKOUT_CANCEL_URL=http://127.0.0.1:3002/settings?checkout=cancel
BILLING_PORTAL_RETURN_URL=http://127.0.0.1:3002/settings
BILLING_LIVE_MODE=false
BILLING_RETENTION_POLICY_CONFIGURED=false
BILLING_REQUIRED_LEGAL_DOCUMENT_KEYS=terms,privacy

# --- Web measurement / AI ---------------------------------------------------
GCP_PROJECT_ID=
GOOGLE_CREDENTIALS_JSON=
GEMINI_API_KEY=
GEMINI_REQUIRE_CLIENT_KEY=false
ANTHROPIC_API_KEY=

# --- Durable Market Lens jobs ----------------------------------------------
# Local test can use inline. Production must be worker or a fully qualified
# Workflow deployment; never enable worker and Workflow together.
MARKET_LENS_JOB_BACKEND=inline
MARKET_LENS_WORKER_ENABLED=false
MARKET_LENS_WORKFLOW_ENABLED=false
MARKET_LENS_WORKFLOW_ENDPOINT=
MARKET_LENS_WORKFLOW_TOKEN=

# Preview suitability only. Do not set these in Production.
WORKFLOW_VITE_ENABLED=false
WORKFLOW_SUITABILITY_ENABLED=false
WORKFLOW_SUITABILITY_TOKEN=
# Optional server-only override. Falls back to SENTRY_DSN when empty.
WORKFLOW_SENTRY_DSN=

# --- Hybrid compatibility only ---------------------------------------------
# Do not onboard new customers through these values. Remove after all legacy
# users have accepted Clerk invitations and the observation window closes.
APP_PASSWORD=
JWT_SECRET=
ADS_CASES_JSON=[]

# --- Local development ------------------------------------------------------
ENVIRONMENT=development
APP_ENV=development
ALLOW_INSECURE_DEV_AUTH=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3002
CORS_ORIGINS=http://127.0.0.1:3002
DATA_PROVIDER=mock
ENABLE_DEBUG_ENDPOINTS=false
