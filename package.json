{
  "name": "insight-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:verified": "npm run build && npm run bundle:check",
    "workflow:verify": "node scripts/verify-workflow-preview.mjs",
    "lint": "eslint src eslint.config.js vite.config.js vitest.config.js",
    "preview": "vite preview",
    "prepare": "husky",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:discovery:rollout:health": "node scripts/discovery-render-rollout-check.mjs --mode=render --attempts=0",
    "smoke:discovery:rollout:render-probe": "node scripts/discovery-render-rollout-check.mjs --mode=render --attempts=1 --pause-ms=0 --min-success-count=1",
    "smoke:discovery:rollout:render-5": "node scripts/discovery-render-rollout-check.mjs --mode=render --attempts=5 --pause-ms=15000 --min-success-count=3",
    "smoke:discovery:rollout:proxy-5": "node scripts/discovery-render-rollout-check.mjs --mode=proxy --attempts=5 --pause-ms=15000 --min-success-count=3",
    "release:production": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/release-production.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --max-warnings 0"
  },
  "overrides": {
    "brace-expansion": "1.1.13",
    "undici": "7.28.0"
  },
  "dependencies": {
    "@clerk/react": "6.12.2",
    "@opentelemetry/api": "1.9.1",
    "@sentry/core": "10.65.0",
    "@sentry/react": "10.65.0",
    "@vercel/speed-insights": "2.0.0",
    "motion": "12.42.2",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.1",
    "remark-gfm": "^4.0.1",
    "workflow": "4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.13.3",
    "tailwindcss": "4.3.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "ws": "8.21.0"
  }
}
